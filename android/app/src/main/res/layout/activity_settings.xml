<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="32dp"
        android:paddingEnd="64dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hint"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView style="@style/Label" android:text="@string/full_url_label" />
        <EditText android:id="@+id/full_url" style="@style/Field" android:inputType="textUri" android:imeOptions="actionDone" />

        <TextView style="@style/Label" android:text="@string/profile_label" />

        <RadioGroup
            android:id="@+id/profiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView style="@style/Label" android:text="@string/api_url_label" />
        <EditText android:id="@+id/api_url" style="@style/Field" android:inputType="textUri" />

        <TextView style="@style/Label" android:text="@string/token_label" />
        <EditText android:id="@+id/token" style="@style/Field" android:inputType="textPassword" />

        <TextView style="@style/Label" android:text="@string/city_label" />
        <EditText android:id="@+id/city" style="@style/Field" android:inputType="textCapWords" />

        <TextView style="@style/Label" android:text="@string/lat_lon_label" />
        <EditText android:id="@+id/lat_lon" style="@style/Field" android:inputType="text" />

        <TextView style="@style/Label" android:text="@string/page_url_label" />
        <EditText android:id="@+id/page_url" style="@style/Field" android:inputType="textUri" />

        <CheckBox
            android:id="@+id/start_on_boot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/start_on_boot"
            android:textSize="20sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minWidth="200dp"
            android:text="@string/save"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
